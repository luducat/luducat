{
  "schema_version": 1,
  "store_name": "jastusa",
  "display_name": "JAST USA",
  "homepage": "https://jaststore.com",
  "badge_label": "JAST",

  "brand_colors": {
    "bg": "#0075D9",
    "text": "#ffffff",
    "badge_bg": "#0075D9",
    "badge_text": "#ffffff"
  },

  "auth": {
    "type": "browser_cookies",
    "domain": "jaststore.com",
    "cookie_name": "auth.token",
    "token_cookie": "auth.token",
    "login_url": "https://jaststore.com/auth/login",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json",
      "Origin": "https://jaststore.com",
      "Referer": "https://jaststore.com/"
    }
  },

  "library": {
    "backend": "api",
    "url": "https://app.jaststore.com/api/v2/shop/account/user-games?page={page}&itemsPerPage=100&sort=product_name_asc",
    "method": "GET",
    "items_path": "products",
    "fields": {
      "id": {"path": "variant.productCode"},
      "title": {"path": "variant.productName"},
      "cover_url": {"path": "variant.productImage", "prefix": "https://app.jaststore.com/media/image/"},
      "game_id": {"path": "variant.gameId"},
      "translation_id": {"path": "variant.game.translations.en_US.id"}
    },
    "pagination": {
      "type": "page_param",
      "param": "page",
      "start": 1,
      "total_path": "pages"
    }
  },

  "detail": {
    "backend": "api",
    "url_template": "https://app.jaststore.com/api/v2/shop/products/{id}",
    "not_found_means_delisted": true,
    "fields": {
      "description": {"path": "translations.en_US.description"},
      "short_description": {"path": "translations.en_US.shortDescription"},
      "publishers": {"path": "publishers[].name"},
      "developers": {"path": "studios[].name"},
      "release_date": {"path": "releaseDate", "transform": "parse_date"},
      "screenshots": {
        "path": "images[].path",
        "filter": {"field": "type", "equals": ""},
        "prefix": "https://app.jaststore.com/media/image/"
      },
      "cover_detail_url": {
        "path": "images[].path",
        "filter": {"field": "type", "equals": "cover"},
        "prefix": "https://app.jaststore.com/media/image/",
        "first": true
      },
      "videos": {"path": "trailers[].url"},
      "genres": {
        "path": "productTaxons[].taxon.name",
        "exclude": [
          "Games", "English", "Japanese", "French", "German", "Spanish",
          "Italian", "Portuguese", "Russian", "Korean", "Chinese",
          "Simplified Chinese", "Traditional Chinese",
          "Windows", "Mac", "Linux"
        ]
      },
      "mature_content": {"path": "productESRB.matureContent"}
    }
  },

  "content_filter": {
    "adult_base_confidence": 0.5,
    "adult_flag": {"field": "mature_content", "equals": true}
  },

  "downloads": {
    "backend": "api",
    "files_url_template": "https://app.jaststore.com/api/v2/shop/account/game-translations/{translation_id}",
    "download_url_template": "https://app.jaststore.com/api/v2/shop/account/user-games/generate-link?gameId={game_id}&gameLinkId={file_id}",
    "fields": {
      "file_id": {"path": "gameLinkId"},
      "game_id": {"path": "gameId"},
      "name": {"path": "label"},
      "size": {"path": "fileSize"},
      "version": {"path": "version"},
      "platform": {"path": "platforms", "first": true, "transform": "lowercase"}
    },
    "buckets": {
      "gamePathLinks": {"bucket": "installers"},
      "gameExtraLinks": {"bucket": "extras"},
      "gamePatchLinks": {"bucket": "patches"}
    },
    "link_request": {
      "method": "POST",
      "url": "https://app.jaststore.com/api/v2/shop/account/user-games/generate-link",
      "body_fields": {"gameId": "game_id", "gameLinkId": "file_id"},
      "body_extra": {"downloaded": false, "type": "default"},
      "url_field": "url"
    },
    "url_page_patterns": [
      "https?://(?:www\\.)?jaststore\\.com/games/([\\w-]+)"
    ]
  },

  "launch": {
    "url_template": "https://jaststore.com/games/{id}"
  },

  "rate_limit": {
    "calls": 60,
    "window_seconds": 60
  }
}
